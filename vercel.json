{
  "buildCommand": "pnpm --filter frontend build",
  "outputDirectory": "frontend/dist/frontend/browser",
  "installCommand": "pnpm install --frozen-lockfile",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://vinyl-intelligence-backend-production.up.railway.app/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
